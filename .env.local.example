# 复制为 .env.local 后由项目所有者本人填写。不得提交真实值。
#
# ── 数据库与登录 ──────────────────────────────────────────────
DATABASE_URL=
AUTH_SECRET=

# ── 阿里云短信 ────────────────────────────────────────────────
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=SMS_512275103

# ── 支付宝（服务端专用，勿加 NEXT_PUBLIC_ 前缀）────────────────
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# PKCS1 | PKCS8（缺省 PKCS8）
ALIPAY_KEY_TYPE=PKCS8
# 选填：不填走正式网关
ALIPAY_GATEWAY=
# 选填：异步通知地址，不填按请求域名推导
ALIPAY_NOTIFY_URL=
# 选填：校验回调里的 seller_id
ALIPAY_SELLER_ID=
# 选填：站点对外域名，不填按请求 origin 推导
APP_BASE_URL=

# ── 图源（服务端专用）────────────────────────────────────────
# 这些密钥只在 /api/assets/search 里读取，不会进入客户端 bundle。
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
EUROPEANA_API_KEY=
